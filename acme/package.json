{
  "name": "acme-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' --if-present build",
    "typecheck": "pnpm -r --filter './packages/*' typecheck && tsc --noEmit",
    "test": "pnpm build && pnpm -r --filter './packages/*' test && pnpm test:e2e",
    "test:e2e": "node --test --experimental-strip-types --no-warnings --test-timeout=60000 \"test/**/*.test.ts\""
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "22.20.5",
    "tsdown": "0.23.7",
    "typescript": "7.0.2"
  }
}
