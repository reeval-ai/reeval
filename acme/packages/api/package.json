{
  "name": "@acme/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "acme-server": "./dist/node.mjs"
  },
  "scripts": {
    "build": "tsdown",
    "types": "wrangler types",
    "typecheck": "wrangler types && tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "dev:worker": "wrangler dev",
    "test": "pnpm test:node && pnpm test:worker",
    "test:node": "node --test --experimental-strip-types --no-warnings --test-timeout=60000 \"test/**/*.test.ts\"",
    "test:worker": "vitest run"
  },
  "dependencies": {
    "@acme/core": "workspace:*",
    "@acme/mcp": "workspace:*",
    "@hono/node-server": "2.1.6",
    "@modelcontextprotocol/server": "2.4.0",
    "hono": "4.13.17",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@cloudflare/vitest-plugin": "1.8.5",
    "@cloudflare/workers-types": "5.20261119.1",
    "vitest": "4.1.12",
    "wrangler": "4.165.0"
  }
}
