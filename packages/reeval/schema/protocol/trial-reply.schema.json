    "TurnData": {
      "description": "A turn as data, as a record or another language's runner carries it: `Turn` without its methods.",
      "type": "object",
      "properties": {
        "diff": {
          "description": "Workspace changes since the eval started, as of the end of this turn.",
          "$ref": "#/$defs/Diff"
        },
        "durationMs": {
          "type": "number"
        },
        "model": {
          "description": "The model the harness says served the turn, e.g. `composer-2.5[fast=false]`; null when it reports none. It can differ from the requested one (an alias, or parameters it filled in).",
          "type": ["string", "null"]
        },
        "prompt": {
          "type": "string"
        },
        "startedAt": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/TurnStatus"
        },
        "text": {
          "description": "The agent's final message for this turn.",
          "type": "string"
        },
        "trajectory": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TrajectoryEvent"
          }
        },
        "unreported": {
          "description": "Event types the harness couldn't report for this turn: the agent may have searched or fetched with no event in `trajectory`. `toHaveSearched()` and `toHaveFetched()` refuse such a turn. Usually `[]`; a Cursor turn whose web calls the adapter couldn't recover (its SDK drops them from the stream) is `['web-search', 'web-fetch']`.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/WebEventType"
          }
        },
        "usage": {
          "description": "Tokens the turn used, its subagents' included; null when the harness reports none.",
          "anyOf": [
            {
              "$ref": "#/$defs/TokenUsage"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "diff",
        "durationMs",
        "model",
        "prompt",
        "startedAt",
        "status",
        "text",
        "trajectory",
        "unreported",
        "usage"
      ],
      "additionalProperties": false
    },
    "TurnStatus": {
      "type": "string",
      "enum": ["completed", "aborted", "error"]
    },
    "WebEventType": {
      "description": "The trajectory events a harness may be unable to report.",
      "type": "string",
      "enum": ["web-search", "web-fetch"]
    }
  }
