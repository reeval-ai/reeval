{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated from TrialReply in src/contract/trial.ts by `pnpm schema:update`; don't edit. reeval's reply to a trial request.",
  "title": "TrialReply",
  "$ref": "#/$defs/TrialReply",
  "$defs": {
    "Capture": {
      "description": "What `c.capture()` returns: the PNG is also in the trial record under `artifacts/`, and the page facts in `artifacts/<name>.capture.json` beside it.",
      "type": "object",
      "properties": {
        "console": {
          "description": "Each message the console showed, in order; at most 100 of each level.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "level": {
                "type": "string",
                "enum": ["error", "warning", "info", "log", "debug"]
              },
              "source": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            },
            "required": ["level", "source", "text"],
            "additionalProperties": false
          }
        },
        "dropped": {
          "description": "How many messages, errors and requests the caps left out; absent when none.",
          "type": "number"
        },
        "errors": {
          "description": "The page errors: each uncaught exception and unhandled promise rejection, with its stack, at most 100.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "failedRequests": {
          "description": "Requests that failed or answered 400 or above, in order, at most 100.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "error": {
                "type": "string"
              },
              "method": {
                "type": "string"
              },
              "status": {
                "type": "number"
              },
              "url": {
                "type": "string"
              }
            },
            "required": ["method", "url"],
            "additionalProperties": false
          }
        },
        "file": {
          "description": "`artifacts/<name>.png` under the trial directory.",
          "type": "object",
          "properties": {
            "bytes": {
              "type": "number"
            },
            "path": {
              "type": "string"
            },
            "sha256": {
              "type": "string"
            }
          },
          "required": ["bytes", "path", "sha256"],
          "additionalProperties": false
        },
        "finalUrl": {
          "description": "Where the page ended up, after redirects and client-side routing: a path on the app.",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "path": {
          "description": "Path on the app, as passed in.",
          "type": "string"
        },
        "port": {
          "description": "Container port that was tunneled.",
          "type": "number"
        },
        "status": {
          "description": "The HTTP status of the main frame's latest document, after redirects. A full navigation replaces it; a client-side route change keeps it. Absent when no response came.",
          "type": "number"
        },
        "viewport": {
          "description": "What the author asked, including `'full-page'`.",
          "anyOf": [
            {
              "$ref": "#/$defs/CaptureWindow"
            },
            {
              "type": "string",
              "const": "full-page"
            }
          ]
        }
      },
      "required": [
        "console",
        "errors",
        "failedRequests",
        "file",
        "finalUrl",
        "name",
        "path",
        "port",
        "viewport"
      ],
      "additionalProperties": false
    },
    "CaptureWindow": {
      "description": "Live tab size for `c.capture()`. Default 1280×720 when the call and cascade omit `viewport`.",
      "type": "object",
      "properties": {
        "height": {
          "description": "In CSS pixels.",
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "width": {
          "description": "In CSS pixels.",
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": ["height", "width"],
      "additionalProperties": false
    },
    "DecideResult": {
      "description": "`c.decide()`'s result, its response's id, headers and body left out.",
      "type": "object",
      "properties": {
        "answers": {
          "description": "Each question's answer, by id, as `experimental_decide` returns it.",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/JSONValue"
          }
        },
        "providerMetadata": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "$ref": "#/$defs/JSONValue"
            }
          }
        },
        "response": {
          "type": "object",
          "properties": {
            "modelId": {
              "type": "string"
            },
            "timestamp": {
              "description": "ISO 8601.",
              "type": "string"
            }
          },
          "required": ["modelId", "timestamp"],
          "additionalProperties": false
        },
        "usage": {
          "type": "object",
          "properties": {
            "inputTokens": {
              "type": "number"
            },
            "outputTokens": {
              "type": "number"
            },
            "totalTokens": {
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JSONValue"
          }
        }
      },
      "required": ["answers", "response", "usage", "warnings"],
      "additionalProperties": false
    },
    "Diff": {
      "type": "object",
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FileChange"
          }
        },
        "patch": {
          "type": "string"
        }
      },
      "required": ["files", "patch"],
      "additionalProperties": false
    },
    "ExecResult": {
      "type": "object",
      "properties": {
        "exitCode": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "stderr": {
          "type": "string"
        },
        "stdout": {
          "type": "string"
        }
      },
      "required": ["exitCode", "stderr", "stdout"],
      "additionalProperties": false
    },
    "FileChange": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["added", "modified", "deleted"]
        }
      },
      "required": ["path", "status"],
      "additionalProperties": false
    },
    "JSONValue": {
      "description": "Any JSON value.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JSONValue"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/JSONValue"
          }
        }
      ]
    },
    "TokenUsage": {
      "description": "The tokens one turn used, as its harness reported them. `input` excludes cache reads and writes (so the prompt was `input + cacheRead + cacheWrite`); `reasoning` is part of `output`.",
      "type": "object",
      "properties": {
        "cacheRead": {
          "type": "number"
        },
        "cacheWrite": {
          "type": "number"
        },
        "input": {
          "type": "number"
        },
        "output": {
          "type": "number"
        },
        "reasoning": {
          "type": ["number", "null"]
        }
      },
      "required": ["cacheRead", "cacheWrite", "input", "output", "reasoning"],
      "additionalProperties": false
    },
    "TrajectoryEvent": {
      "description": "Normalized agent events. Each tool call is one event, merged with its result; `durationMs` is wall time until the result arrived (Cursor's own `completed_at_ms` can be earlier). Null when the harness never reported the end. Long shell or edit calls set `stalled: true`. A call the harness never reported a result for (the turn ended or was cut short first) has `ok: null`: it isn't known to have failed, and no failure count includes it.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "atMs": {
              "type": "number"
            },
            "durationMs": {
              "type": ["number", "null"]
            },
            "step": {
              "description": "The harness's step in its turn the event came in, from 1: a model call where the adapter reports each one (Claude Code, Antigravity, pi; the ACP harnesses' steps end when a call's tools have all returned), the whole turn on Codex and Cursor. Absent when the harness reports no steps, and on `model-call` events.",
              "type": "number"
            },
            "subagent": {
              "description": "The `toolCallId` of the subagent call whose agent said it; absent for the agent's own.",
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "ts": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": ["text", "reasoning"]
            }
          },
          "required": ["atMs", "durationMs", "text", "ts", "type"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "added": {
              "description": "Line counts, or null when the harness didn't send the content (e.g. deletes).",
              "type": ["number", "null"]
            },
            "atMs": {
              "type": "number"
            },
            "durationInferred": {
              "description": "Set when the harness never reported the call's end, so `durationMs` runs to the next event's `atMs` (the turn's end for the last).",
              "type": "boolean",
              "const": true
            },
            "durationMs": {
              "type": ["number", "null"]
            },
            "input": {
              "description": "The tool's input, as a `tool` event's `input`."
            },
            "kind": {
              "description": "`write` is a whole-file write whose result doesn't say whether the file existed before (Antigravity's, fx's, Goose's, Grok Build's and pi's write tools, for example).",
              "type": "string",
              "enum": ["create", "modify", "write", "delete"]
            },
            "output": {
              "description": "The tool's result, as a `tool` event's `output`; absent when the harness never reported one."
            },
            "outputTruncated": {
              "description": "Set when `output` is only part of the output, as a `tool` event's `outputTruncated`.",
              "type": "object",
              "properties": {
                "bytes": {
                  "type": "number"
                }
              },
              "required": ["bytes"],
              "additionalProperties": false
            },
            "outputView": {
              "description": "What `output` holds, as a `tool` event's `outputView`.",
              "type": "string",
              "enum": ["model", "full"]
            },
            "path": {
              "type": "string"
            },
            "removed": {
              "type": ["number", "null"]
            },
            "stalled": {
              "description": "True when a shell-like tool or edit ran at least two minutes.",
              "type": "boolean"
            },
            "step": {
              "description": "The harness's step in its turn the event came in, from 1: a model call where the adapter reports each one (Claude Code, Antigravity, pi; the ACP harnesses' steps end when a call's tools have all returned), the whole turn on Codex and Cursor. Absent when the harness reports no steps, and on `model-call` events.",
              "type": "number"
            },
            "subagent": {
              "description": "The `toolCallId` of the subagent call whose agent made this call; absent for the agent's own.",
              "type": "string"
            },
            "toolCallId": {
              "type": "string"
            },
            "ts": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "file-edit"
            }
          },
          "required": [
            "added",
            "atMs",
            "durationMs",
            "kind",
            "path",
            "removed",
            "toolCallId",
            "ts",
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "atMs": {
              "type": "number"
            },
            "durationInferred": {
              "description": "Set when the harness never reported the call's end, so `durationMs` runs to the next event's `atMs` (the turn's end for the last).",
              "type": "boolean",
              "const": true
            },
            "durationMs": {
              "type": ["number", "null"]
            },
            "input": {
              "description": "The tool's input, as a `tool` event's `input`."
            },
            "ok": {
              "description": "Whether the search succeeded. Absent means it did; null means the harness never reported its result.",
              "type": ["boolean", "null"]
            },
            "output": {
              "description": "The tool's result, as a `tool` event's `output`; absent when the harness never reported one."
            },
            "outputTruncated": {
              "description": "Set when `output` is only part of the output, as a `tool` event's `outputTruncated`.",
              "type": "object",
              "properties": {
                "bytes": {
                  "type": "number"
                }
              },
              "required": ["bytes"],
              "additionalProperties": false
            },
            "outputView": {
              "description": "What `output` holds, as a `tool` event's `outputView`.",
              "type": "string",
              "enum": ["model", "full"]
            },
            "query": {
              "type": "string"
            },
            "references": {
              "description": "How many sources the harness says it used; Cursor sends no URLs or titles.",
              "type": ["number", "null"]
            },
            "stalled": {
              "description": "True when a shell-like tool or edit ran at least two minutes.",
              "type": "boolean"
            },
            "step": {
              "description": "The harness's step in its turn the event came in, from 1: a model call where the adapter reports each one (Claude Code, Antigravity, pi; the ACP harnesses' steps end when a call's tools have all returned), the whole turn on Codex and Cursor. Absent when the harness reports no steps, and on `model-call` events.",
              "type": "number"
            },
            "subagent": {
              "description": "The `toolCallId` of the subagent call whose agent made this call; absent for the agent's own.",
              "type": "string"
            },
            "toolCallId": {
              "type": "string"
            },
            "ts": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "web-search"
            }
          },
          "required": ["atMs", "durationMs", "query", "references", "toolCallId", "ts", "type"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "atMs": {
              "type": "number"
            },
            "bytes": {
              "description": "The size of the fetched content the harness reports, in bytes; absent when it reports none.",
              "type": "number"
            },
            "durationInferred": {
              "description": "Set when the harness never reported the call's end, so `durationMs` runs to the next event's `atMs` (the turn's end for the last).",
              "type": "boolean",
              "const": true
            },
            "durationMs": {
              "type": ["number", "null"]
            },
            "input": {
              "description": "The tool's input, as a `tool` event's `input`."
            },
            "ok": {
              "description": "Whether the fetch succeeded; null when the harness never reported its result.",
              "type": ["boolean", "null"]
            },
            "output": {
              "description": "The tool's result, as a `tool` event's `output`; absent when the harness never reported one."
            },
            "outputTruncated": {
              "description": "Set when `output` is only part of the output, as a `tool` event's `outputTruncated`.",
              "type": "object",
              "properties": {
                "bytes": {
                  "type": "number"
                }
              },
              "required": ["bytes"],
              "additionalProperties": false
            },
            "outputView": {
              "description": "What `output` holds, as a `tool` event's `outputView`.",
              "type": "string",
              "enum": ["model", "full"]
            },
            "stalled": {
              "description": "True when a shell-like tool or edit ran at least two minutes.",
              "type": "boolean"
            },
            "status": {
              "description": "The HTTP status the harness reports for the fetch; absent when it reports none.",
              "type": "number"
            },
            "step": {
              "description": "The harness's step in its turn the event came in, from 1: a model call where the adapter reports each one (Claude Code, Antigravity, pi; the ACP harnesses' steps end when a call's tools have all returned), the whole turn on Codex and Cursor. Absent when the harness reports no steps, and on `model-call` events.",
              "type": "number"
            },
            "subagent": {
              "description": "The `toolCallId` of the subagent call whose agent made this call; absent for the agent's own.",
              "type": "string"
            },
            "toolCallId": {
              "type": "string"
            },
            "ts": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "web-fetch"
            },
            "url": {
              "type": "string"
            }
          },
          "required": ["atMs", "durationMs", "ok", "toolCallId", "ts", "type", "url"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "atMs": {
              "type": "number"
            },
            "durationInferred": {
              "description": "Set when the harness never reported the call's end, so `durationMs` runs to the next event's `atMs` (the turn's end for the last).",
              "type": "boolean",
              "const": true
            },
            "durationMs": {
              "type": ["number", "null"]
            },
            "input": {
              "description": "The tool's input. `trajectory.jsonl` keeps one whose JSON is past 128K characters as text: its first 96K and last 16K characters, with a line where the rest was cut."
            },
            "ok": {
              "description": "Whether the call succeeded; null when the harness never reported its result.",
              "type": ["boolean", "null"]
            },
            "output": {},
            "outputTruncated": {
              "description": "Set when `output` is only part of the output, with a line where the rest was cut: `trajectory.jsonl` keeps the first 96K and last 16K characters of one past 128K (of its JSON, for structured output), and the harness adapter keeps the first and last 512 KiB of a saved output past 1 MiB. `bytes` is the whole output's size in UTF-8.",
              "type": "object",
              "properties": {
                "bytes": {
                  "type": "number"
                }
              },
              "required": ["bytes"],
              "additionalProperties": false
            },
            "outputView": {
              "description": "What `output` holds: `model`, the result as the harness gave it to the model; `full`, the tool's whole output, which can be more than the model saw (the harness cut it for the model, or saved it to a file and gave the model a pointer, which reeval read).",
              "type": "string",
              "enum": ["model", "full"]
            },
            "stalled": {
              "description": "True when a shell-like tool or edit ran at least two minutes.",
              "type": "boolean"
            },
            "step": {
              "description": "The harness's step in its turn the event came in, from 1: a model call where the adapter reports each one (Claude Code, Antigravity, pi; the ACP harnesses' steps end when a call's tools have all returned), the whole turn on Codex and Cursor. Absent when the harness reports no steps, and on `model-call` events.",
              "type": "number"
            },
            "subagent": {
              "description": "The `toolCallId` of the subagent call whose agent made this call; absent for the agent's own.",
              "type": "string"
            },
            "tool": {
              "type": "string"
            },
            "toolCallId": {
              "type": "string"
            },
            "ts": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "tool"
            }
          },
          "required": [
            "atMs",
            "durationMs",
            "input",
            "ok",
            "output",
            "tool",
            "toolCallId",
            "ts",
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "atMs": {
              "type": "number"
            },
            "message": {
              "type": "string"
            },
            "step": {
              "description": "The harness's step in its turn the event came in, from 1: a model call where the adapter reports each one (Claude Code, Antigravity, pi; the ACP harnesses' steps end when a call's tools have all returned), the whole turn on Codex and Cursor. Absent when the harness reports no steps, and on `model-call` events.",
              "type": "number"
            },
            "ts": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "error"
            }
          },
          "required": ["atMs", "message", "ts", "type"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "atMs": {
              "type": "number"
            },
            "message": {
              "type": "string"
            },
            "step": {
              "description": "The harness's step in its turn the event came in, from 1: a model call where the adapter reports each one (Claude Code, Antigravity, pi; the ACP harnesses' steps end when a call's tools have all returned), the whole turn on Codex and Cursor. Absent when the harness reports no steps, and on `model-call` events.",
              "type": "number"
            },
            "ts": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "retry"
            }
          },
          "required": ["atMs", "message", "ts", "type"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "atMs": {
              "type": "number"
            },
            "durationMs": {
              "type": "number"
            },
            "firstByteMs": {
              "description": "Milliseconds from the call's start to its response body's first byte; null when none came.",
              "type": ["number", "null"]
            },
            "model": {
              "description": "The model that served it, from its request or response; null when neither named one.",
              "type": ["string", "null"]
            },
            "request": {
              "description": "`POST api.anthropic.com/v1/messages`: the method, host and path.",
              "type": "string"
            },
            "role": {
              "description": "`main` for one of the agent's own steps, `side` for a call its CLI made around them: a session title, a web search's own model call, Antigravity's Flash Lite calls. A call is `main` when its tokens are one of the turn's steps' as the harness reported them. Otherwise it's `side` when its request declared at most one tool while another call in the trial declared more, or when another model served it than served the turn's other calls, and `main` when neither holds. Absent in records from before roles.",
              "type": "string",
              "enum": ["main", "side"]
            },
            "status": {
              "description": "The response's HTTP status; null when none came.",
              "type": ["number", "null"]
            },
            "step": {
              "description": "The harness's step in its turn the event came in, from 1: a model call where the adapter reports each one (Claude Code, Antigravity, pi; the ACP harnesses' steps end when a call's tools have all returned), the whole turn on Codex and Cursor. Absent when the harness reports no steps, and on `model-call` events.",
              "type": "number"
            },
            "stream": {
              "description": "Set on a call that carries the whole turn (Cursor's), so it isn't counted as model time.",
              "type": "boolean",
              "const": true
            },
            "ts": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "model-call"
            },
            "usage": {
              "description": "The tokens its response body named; null when it named none (Cursor's are protobuf).",
              "anyOf": [
                {
                  "$ref": "#/$defs/TokenUsage"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "atMs",
            "durationMs",
            "firstByteMs",
            "model",
            "request",
            "status",
            "ts",
            "type",
            "usage"
          ],
          "additionalProperties": false
        }
      ]
    },
    "TrialError": {
      "description": "Why a call failed, in reeval's words.",
      "type": "object",
      "properties": {
        "message": {
          "type": "string"
        },
        "name": {
          "description": "The error's class, e.g. `UsageError` or `AssertionError`.",
          "type": "string"
        }
      },
      "required": ["message", "name"],
      "additionalProperties": {}
    },
    "TrialReply": {
      "description": "reeval's reply to a call: its result, or the error it threw.",
      "anyOf": [
        {
          "oneOf": [
            {
